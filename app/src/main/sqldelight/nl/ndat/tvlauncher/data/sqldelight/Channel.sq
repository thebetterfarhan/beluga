import nl.ndat.tvlauncher.data.model.ChannelType;

CREATE TABLE Channel (
	id TEXT NOT NULL PRIMARY KEY,
	type TEXT AS ChannelType NOT NULL,
	channelId INTEGER NOT NULL,
	displayName TEXT NOT NULL,
	description TEXT,
	packageName TEXT NOT NULL,
	appLinkIntentUri TEXT,
	weight INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX channelType ON Channel(type);
CREATE INDEX channelPackageName ON Channel(packageName);

getAll:
SELECT * FROM Channel ORDER BY weight ASC;

getFavoriteAppChannels:
SELECT * FROM Channel WHERE (SELECT favoriteOrder FROM App WHERE App.packageName = Channel.packageName) IS NOT NULL ORDER BY weight ASC;

getById:
SELECT * FROM Channel WHERE id = :id LIMIT 1;

getByType:
SELECT * FROM Channel WHERE type = :type;

upsert {
	UPDATE Channel SET
		type = :type,
        channelId = :channelId,
        displayName = :displayName,
        description = :description,
        packageName = :packageName,
        appLinkIntentUri = :appLinkIntentUri,
        weight = :weight
	WHERE id = :id;

	INSERT OR IGNORE INTO Channel (
		id,
		type,
        channelId,
        displayName,
        description,
        packageName,
        appLinkIntentUri,
        weight
	) VALUES (
		:id,
		:type,
        :channelId,
        :displayName,
        :description,
        :packageName,
        :appLinkIntentUri,
        :weight
	);
}

updateChannelWeight:
UPDATE Channel SET weight = :weight WHERE id = :id;

removeById:
DELETE FROM Channel WHERE id = :id;

removeByType:
DELETE FROM Channel WHERE type = :type;
